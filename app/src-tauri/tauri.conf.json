{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Citadel",
  "mainBinaryName": "citadel",
  "version": "0.1.1",
  "identifier": "io.github.sepehrmohseni.citadel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Citadel",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0a0c0f",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": false,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
    "publisher": "Sepehr Mohseni",
    "homepage": "https://sepehrmohseni.github.io/citadel/",
    "category": "DeveloperTool",
    "shortDescription": "Local-first SSH, tunnel and infrastructure workstation",
    "longDescription": "Citadel is a zero-knowledge SSH client with an encrypted local vault, bastion chaining, self-healing port forwards, SFTP and agentless host telemetry.",
    "copyright": "Copyright (c) 2026 The Citadel Authors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/64x64.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "net",
        "conflicts": ["citadel-client"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "22603e35-d4fe-5288-910e-61a7aa633178"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
